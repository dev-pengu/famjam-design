{
  "name": "@famjam/icons",
  "version": "0.0.3",
  "type": "module",
  "main": "./dist/index.web.js",
  "types": "./dist/index.web.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.web.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./web": {
      "types": "./dist/index.web.d.ts",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./native": {
      "types": "./dist/index.native.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.native.js",
      "default": "./dist/index.native.js"
    },
    "./*.svg": "./dist/assets/*.svg"
  },
  "scripts": {
    "generate-icons": "node ./scripts/generate-icons.js",
    "build": "pnpm run generate-icons && tsdown && tsc -b --emitDeclarationOnly --force",
    "check-types": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@svgr/core": "*",
    "@svgr/plugin-jsx": "*",
    "@svgr/plugin-svgo": "*",
    "@types/react": "*",
    "prettier": "*",
    "react": "*",
    "react-native-svg": "*",
    "svgo": "*",
    "tsdown": "*",
    "typescript": "*"
  },
  "engines": {
    "npm": "please-use-pnpm"
  },
  "engineStrict": true
}
