{
  "name": "@famjam/icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/icons/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project @famjam/icons --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["build"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf dist/libs/icons",
          "mkdir dist/libs/icons",
          "cp -r libs/icons/dist dist/libs/icons",
          "cp -r libs/icons/assets dist/libs/icons/dist",
          "cp libs/icons/package.json dist/libs/icons/package.json",
          "cp libs/icons/README.md dist/libs/icons/README.md"
        ]
      }
    },
    "bundle": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      }
    },
    "optimize": {
      "executor": "nx:run-script",
      "options": {
        "script": "optimize"
      }
    },
    "nx-release-publish": {
      "options": {
        "registry": "http://localhost:4873",
        "access": "public",
        "tag": "next",
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
