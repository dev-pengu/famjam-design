{
  "name": "@famjam/icons",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/icons/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project @famjam/icons --web",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      }
    },
    "optimize": {
      "executor": "nx:run-script",
      "options": {
        "script": "optimize"
      }
    },
    "nx-release-publish": {
      "options": {
        "registry": "http://localhost:4873",
        "access": "public",
        "tag": "next",
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
