{
  "name": "@famjam/ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project @famjam/ui --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["bundle"],
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf dist/libs/ui",
          "mkdir dist/libs/ui",
          "cp -r libs/ui/dist dist/libs/ui/",
          "cp libs/ui/package.json dist/libs/ui/package.json",
          "cp libs/ui/README.md dist/libs/ui/README.md"
        ]
      }
    },
    "bundle": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      }
    },
    "generate-package-json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-package-json.mjs ui"
      },
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "options": {
        "registry": "http://localhost:4873",
        "access": "public",
        "tag": "next",
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
