{
  "extends": "../../react-tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "composite": true,
    "incremental": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "moduleSuffixes": [".web", ".native", ""],
    "types": ["jest"],
    "resolveJsonModule": true
  },
  "include": ["src", "src/**/*.json", "declarations.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.stories.ts", "**/*.stories.js", "**/*.stories.jsx", "**/*.stories.tsx"]
}
