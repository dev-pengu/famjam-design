{
  "extends": "@org/typescript-config/react-library.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "composite": true,
    "incremental": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "moduleSuffixes": [".web", ".native", ""],
    "types": ["jest"],
    "resolveJsonModule": true
  },
  "include": ["src", "src/**/*.json", "declarations.d.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "node_modules",
    "dist"
  ]
}
