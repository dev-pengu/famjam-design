{
  "name": "@famjam/fonts",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./native/config": {
      "types": "./dist/config/native.d.ts",
      "import": "./dist/config/native.js",
      "require": "./dist/config/native/cjs",
      "default": "./dist/config/native.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js",
      "require": "./dist/native/index.cjs",
      "default": "./dist/native/index.js"
    },
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b --noEmit",
    "parse": "node src/ot.ts",
    "lint": "eslint --max-warnings 0",
    "test": "jest",
    "test:report": "jest --coverage || true && pnpm dlx http-server coverage/lcov-report -o"
  },
  "devDependencies": {
    "@org/eslint-config": "*",
    "@org/typescript-config": "*",
    "@famjam/tokens": "*",
    "@types/jest": "*",
    "@types/node": "*",
    "eslint": "*",
    "eslint-plugin-jest": "*",
    "jest": "*",
    "ts-jest": "*",
    "tsdown": "*",
    "typescript": "*"
  },
  "engines": {
    "npm": "please-use-pnpm"
  },
  "engineStrict": true
}
