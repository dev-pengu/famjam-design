{
  "name": "@famjam/fonts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/fonts/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["bundle"],
      "cache": true,
      "options": {
        "parallel": false,
        "commands": [
          "rm -rf dist/libs/fonts",
          "mkdir dist/libs/fonts",
          "cp -r libs/fonts/dist dist/libs/fonts",
          "cp -r libs/fonts/assets dist/libs/fonts/dist",
          "cp libs/fonts/package.json dist/libs/fonts/package.json",
          "cp libs/fonts/README.md dist/libs/fonts/README.md"
        ]
      }
    },
    "bundle": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      }
    },
    "generate-package-json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/generate-package-json.mjs fonts"
      },
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/fonts/jest.config.cts"
      }
    },
    "nx-release-publish": {
      "options": {
        "registry": "http://localhost:4873",
        "access": "public",
        "tag": "next",
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
